<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>AMAbot</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="app">

  

    <div class="header">
      <div class="text-header">
        <h1>Malte Krog AMAbot</h1>
        <p>Stil mig et spørgsmål, så svarer jeg så godt jeg kan</p>
      </div>
    </div>

    <section class="chat-container">
      <div class="malte">
        <img src="/assets/malte.jpg" alt="Malte Krog" />
        <p>Hej! Jeg er Malte Krog... bla bla</p>
      </div>

      <div class="chat" id="chat">
      
        <% for (const message of messages) { %>
          <div class="message <%= message.type === 'question' ? 'user' : 'bot' %>">
            <span class="label"><%= message.type === 'question' ? '' : 'MalteBot' %></span>
            <%= message.text %>
          </div>
        <% } %>
      </div>
    </section>

    <% if (error) { %>
      <p role="alert" style="color:#f87171; padding: 0 18px;"><%= error %></p>
    <% } %>

   <form class="composer" method="POST" action="/ask">
    <input type="text" name="question" placeholder="Skriv din besked..." />
    <button id="send-button" type="submit">Send</button>
  </form>

  <form method="POST" action="/clear-messages">
    <button type="submit">Ryd beskeder</button>
  </form>

  </main>
  <script src="/script.js"></script>
</body>
</html>